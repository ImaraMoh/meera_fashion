generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String   @id @db.VarChar(100)
  name               String   @db.VarChar(255)
  slug               String?  @db.VarChar(255)
  category           String?  @db.VarChar(50)
  subcategory        String?  @db.VarChar(100)
  price              Decimal  @default(0) @db.Decimal(10, 2)
  originalPrice      Decimal? @db.Decimal(10, 2)
  discountPercentage Int?     @default(0)
  description        String?
  shortDescription   String?
  material           String?
  color              String?
  stockStatus        String?  @db.VarChar(50)
  stockQuantity      Int?     @default(0)
  isPreOrder         Boolean  @default(false)
  isFeatured         Boolean  @default(false)
  isNewArrival       Boolean  @default(false)
  isOffer            Boolean  @default(false)
  isDancePerformance Boolean  @default(false)
  images             Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("products")
}

model Setting {
  id               Int      @id @default(autoincrement())
  brandName        String?  @map("brand_name") @db.VarChar(255)
  tagline          String?  @db.VarChar(255)
  phone            String?  @db.VarChar(50)
  formattedPhone   String?  @map("formatted_phone") @db.VarChar(50)
  whatsappNumber   String?  @map("whatsapp_number") @db.VarChar(50)
  email            String?  @db.VarChar(255)
  address          String?  @db.VarChar(255)
  instagramHandle  String?  @map("instagram_handle") @db.VarChar(255)
  instagramUrl     String?  @map("instagram_url") @db.VarChar(255)
  tiktokHandle     String?  @map("tiktok_handle") @db.VarChar(255)
  tiktokUrl        String?  @map("tiktok_url") @db.VarChar(255)
  facebookUrl      String?  @map("facebook_url") @db.VarChar(255)
  announcementText String?  @map("announcement_text")
  showAnnouncement Boolean  @default(true) @map("show_announcement")
  enableRentalMode Boolean  @default(false) @map("enable_rental_mode")
  currencySymbol   String?  @map("currency_symbol") @db.VarChar(10)
  currencyCode     String?  @map("currency_code") @db.VarChar(10)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  customLogoUrl    String?  @map("custom_logo_url")

  @@map("settings")
}

model Enquiry {
  id            String   @id @db.VarChar(100)
  customerName  String?  @map("customer_name") @db.VarChar(255)
  customerPhone String?  @map("customer_phone") @db.VarChar(50)
  customerEmail String?  @map("customer_email") @db.VarChar(255)
  notes         String?
  status        String   @default("New") @db.VarChar(50)
  total         Decimal  @default(0) @db.Decimal(10, 2)
  source        String   @default("Web") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  items         Json     @default("[]")
  orderNumber   String   @map("order_number") @db.VarChar(100)
  subtotal      Decimal  @default(0) @db.Decimal(10, 2)
  statusUpdatedAt DateTime? @map("status_updated_at")
  
  @@map("enquiries")
}

model SelectionItem {
  id           String   @id @db.VarChar(100)
  sessionId    String   @default("default") @map("session_id") @db.VarChar(100)
  productId    String   @map("product_id") @db.VarChar(100)
  product      Json
  selectedSize String?  @map("selected_size") @db.VarChar(50)
  quantity     Int      @default(1)
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(10, 2)
  addedAt      DateTime @default(now()) @map("added_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("selection_items")
}

model WishlistItem {
  id        String   @id @db.VarChar(100)
  sessionId String   @default("default") @map("session_id") @db.VarChar(100)
  productId String   @map("product_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("wishlist_items")
}

model Invoice {
  id              String   @id @db.VarChar(100)
  invoiceNumber   String   @map("invoice_number") @db.VarChar(100)
  enquiryId       String?  @map("enquiry_id") @db.VarChar(100)
  customerName    String   @map("customer_name") @db.VarChar(255)
  customerPhone   String   @map("customer_phone") @db.VarChar(50)
  customerEmail   String   @map("customer_email") @db.VarChar(255)
  customerAddress String?  @map("customer_address")
  items           Json
  subtotal        Decimal  @default(0) @db.Decimal(10, 2)
  discount        Decimal  @default(0) @db.Decimal(10, 2)
  shipping        Decimal  @default(0) @db.Decimal(10, 2)
  total           Decimal  @default(0) @db.Decimal(10, 2)
  status          String   @default("Draft") @db.VarChar(50)
  issueDate       DateTime @map("issue_date")
  dueDate         DateTime @map("due_date")
  paymentMethod   String?  @map("payment_method") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("invoices")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}
